{
  "name": "backroom-games",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"pnpm --filter @backroom/server dev\" \"pnpm --filter @backroom/client dev\"",
    "dev:host": "concurrently -k -n server,client -c blue,magenta \"pnpm --filter @backroom/server dev\" \"pnpm --filter @backroom/client dev --host 0.0.0.0\"",
    "build": "pnpm -r build",
    "start": "pnpm --filter @backroom/server start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc && pnpm -r typecheck",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "concurrently": "10.0.5",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
